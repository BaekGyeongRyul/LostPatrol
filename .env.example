# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
# 웹 프론트엔드에는 절대 SERVICE_ROLE_KEY를 넣지 않습니다. anon/publishable key만 사용합니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# robot/ , vision/ 처럼 신뢰된 서버/디바이스 코드에서만 사용하는 값입니다.
# 절대 이 값을 실제로 채워서 Git에 커밋하지 마세요. 각자 로컬 .env에만 두세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
