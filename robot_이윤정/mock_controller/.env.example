# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고 KEY 값을 채워넣으세요.
#
#   cp .env.example .env
#
# .env가 없거나 KEY가 비어있으면 store.py는 자동으로
# 로컬 JSON 파일(data/) 을 대신 사용합니다 — 즉 이 파일을
# 채우는 순간 코드 수정 없이 Supabase로 전환됩니다.
#
# SUPABASE_SERVICE_ROLE_KEY는 Supabase 대시보드 > Project Settings > API
# 에서 본인이 직접 확인하세요 (팀 문서/채팅에 올라오지 않는 값입니다 —
# RLS를 완전히 우회하는 키라서 절대 Git에 커밋하거나 공유하면 안 됩니다).

SUPABASE_URL=https://uityxtduglbshnvkstvx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
