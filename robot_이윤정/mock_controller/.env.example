# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고 KEY 값을 채워넣으세요.
#
#   cp .env.example .env
#
# .env가 없거나 KEY가 비어있으면 store.py는 자동으로
# 로컬 JSON 파일(data/) 을 대신 사용합니다 — 즉 이 파일을
# 채우는 순간 코드 수정 없이 Supabase로 전환됩니다.
#
# SUPABASE_ANON_KEY는 웹(web_백경률)이 쓰는 것과 같은 anon(public) key
# 입니다 — Project Settings > API에서 확인. 원래 robot_commands/
# robot_status에 UPDATE 권한이 없어서 한때 service_role key를 썼으나,
# 백경률이 anon 역할에 제한적인 UPDATE RLS 정책을 추가해줘서 이제는
# 웹과 동일하게 이 public key만으로 충분합니다. 그래도 이 값은 로컬
# .env에만 두고 Git에 커밋하지 마세요.

SUPABASE_URL=https://uityxtduglbshnvkstvx.supabase.co
SUPABASE_ANON_KEY=
