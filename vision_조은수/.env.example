# 복사해서 ".env"로 저장하고 SUPABASE_ANON_KEY 채워넣으세요.
#   cp .env.example .env
# anon(public) key입니다 — robot_이윤정 쪽과 동일한 값 그대로 써도 됩니다.

SUPABASE_URL=https://uityxtduglbshnvkstvx.supabase.co
SUPABASE_ANON_KEY=

# 아래는 전부 선택 — 안 채우면 코드 안의 기본값 사용
CONFIDENCE_THRESHOLD=0.6
CONSECUTIVE_REQUIRED=2
DEFAULT_LOCATION=A구역
